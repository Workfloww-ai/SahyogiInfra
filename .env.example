# Required — Gmail account used as the sender
GMAIL_USER=no-reply@yourcompany.com

# Gmail App Password (Google Account > Security > 2-Step Verification > App Passwords)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where contact form submissions are sent
RECIPIENT_EMAIL=you@yourcompany.com

# Comma-separated list of allowed frontend origins (set your Vercel URL here)
# Example: https://sahyogiinfra.vercel.app,https://www.sahyogi.net.in
ALLOWED_ORIGINS=https://your-vercel-url.vercel.app
